    "_color": {
      "__type__": "cc.Color",
      "r": 0,
      "g": 0,
      "b": 0,
      "a": 255
    },
    "_string": "Winning Rules\n\nWins are paid from left to right.\nMultiple paylines can win in a single spin.\nThe highest win per payline is awarded.\nAll payouts are based on the total bet.\n\nSpecial Features\n\nScatter symbols award Free Spins.\nWild symbols substitute for regular symbols.\nBonus symbols trigger the Bonus Game.\nJackpot prizes may be awarded during eligible features.\nGamble feature allows qualifying wins to be doubled.\n\nGame Information\n\nRTP: 96.20% (or your configured RTP)\nVolatility: High\nOutcomes are determined by a certified Random Number Generator (RNG).\nEach spin is independent and previous results do not affect future outcomes.\n\nResponsible Gaming\nPlay responsibly and within your limits. This game is intended for players of legal gambling age in their jurisdiction.",
    "_horizontalAlign": 1,
    "_verticalAlign": 1,
    "_actualFontSize": 25,
    "_fontSize": 25,
    "_fontFamily": "Arial",
    "_lineHeight": 20,
    "_overflow": 3,
    "_enableWrapText": true,
    "_font": {
      "__uuid__": "7deedefa-328e-4ca6-a14d-0d411132152d",
      "__expectedType__": "cc.TTFFont"
    },
    "_isSystemFontUsed": false,
    "_spacingX": 0,
    "_isItalic": false,
    "_isBold": false,
    "_isUnderline": false,
    "_underlineHeight": 2,
    "_cacheMode": 0,
    "_isUseVerticalKerning": false,
    "_verticalKerning": null,
    "_id": "f5gabj/a9PX4VQQI/iiFel"
  },
